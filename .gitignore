# =============================================================
#  Fitness Management System — Root .gitignore
# =============================================================

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE ───────────────────────────────────────────────────────
.idea/
**/.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.sts4-cache

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
build.log

# ── Secrets (NEVER commit these) ─────────────────────────────
.env
.env.local
.env.prod
*.key
*.pem
*.p12
*.jks

# ── Build artifacts ───────────────────────────────────────────
# Backend
target/

# Frontend
node_modules/
.angular/
dist/
out-tsc/
coverage/

# ── Misc scripts / temp ───────────────────────────────────────
cleanup.sh

# ── Uploads (runtime-generated) ──────────────────────────────
uploads/
