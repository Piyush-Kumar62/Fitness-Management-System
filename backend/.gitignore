# =============================================================
#  Backend .gitignore
# =============================================================

# IDE — IntelliJ IDEA project files
.idea/
*.iml
*.ipr
*.iws

# Maven build output
target/
bin/

# Maven wrapper (keep the jar)
!.mvn/wrapper/maven-wrapper.jar

# Spring
.springBeans
.factorypath

# Secrets — NEVER commit
.env
.env.local
.env.prod
env/.env.dev
env/.env.prod

# Runtime-generated uploads
uploads/

# Logs
logs/
*.log
